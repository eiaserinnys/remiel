DATABASE_URL=postgresql://remiel:remiel@localhost:5434/remiel_db
TEST_DATABASE_URL=postgresql://remiel:remiel@localhost:5434/remiel_test_db
PORT=3120
API_KEY=<generate-a-key>

# JWT session secret (required when Slack OAuth is enabled)
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# Slack OAuth (optional — omit to disable dashboard auth in dev)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=https://remiel.eiaserinnys.me/api/auth/slack/callback
SLACK_ALLOWED_TEAM_ID=

# Slack Bot Token (optional — enrichment worker uses this to fetch Slack private files)
SLACK_BOT_TOKEN=

# Interpretation worker model (optional — omit to use soulstream default)
# INTERPRETATION_MODEL=sonnet-4.6
