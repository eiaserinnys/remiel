{
  "name": "remiel-server",
  "version": "0.1.0",
  "description": "Remiel conversation store — PostgreSQL-backed message API + MCP server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "mcp": "node dist/mcp/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
